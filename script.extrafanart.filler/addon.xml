<addon id="script.extrafanart.filler"
       name="ExtraFanart Filler"
       version="0.5.0"
       provider-name="sfontes">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.script" library="script.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="startup"/>
    <extension point="kodi.context.item">
      <menu id="kodi.core.main">
        <item library="contextitem.py">
          <label>30203</label>
          <visible>String.IsEqual(Window(Home).Property(script.extrafanart.filler.enable_contextmenu),True) +
            [String.IsEqual(ListItem.DBtype,movie) | 
            String.IsEqual(ListItem.DBtype,tvshow) | 
            String.IsEqual(ListItem.DBtype,set)]</visible>
        </item>
      </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Fills extrafanart (fanart1, fanart2, …) for Movies, TV Shows, and Movie Sets.</summary>
      <description lang="en_GB">This addon scans Movies, TV Shows, and Movie Sets and fills the extrafanart slots (fanart1, fanart2, fanart3, …). It reuses the remote fanart URLs already scraped by Kodi, copying them from the available fanart artwork into the individual fanart<i> entries. Existing extrafanart is not overwritten. The addon also provides a context menu item to fill in extrafanart for individual Movies, TV Shows, or Movie Sets.
      </description>
      <disclaimer lang="en_GB">This addon fills in artwork URLs. It does not download images.</disclaimer>
      <platform>all</platform>
      <license>GNU GENERAL PUBLIC LICENSE Version 2, June 1991</license>
      <forum>https://forum.kodi.tv/showthread.php?tid=??????</forum>
      <source>https://github.com/smfontes/kodi.extrafanart.filler</source>
      <assets>
        <icon>resources/icon.png</icon>
        <fanart>resources/fanart.png</fanart>
        <banner>resources/banner.png</banner>
        <clearlogo>resources/clearlogo.png</clearlogo>
        <screenshot>resources/screenshotsettings.png</screenshot>
        <screenshot>resources/screenshotrun.png</screenshot>
        <screenshot>resources/screenshotscanLog.png</screenshot>
        <screenshot>resources/screenshotcontextmenulog.png</screenshot>
      </assets>
      <news>
        0.5.0 
         - First release
      </news>
    </extension>
</addon>