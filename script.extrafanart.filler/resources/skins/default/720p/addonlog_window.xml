<window>
    <defaultcontrol always="true">2</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1280</width>
            <height>720</height>
            <texture>log_background.png</texture>
        </control>
        <control type="textbox" id="1">
            <left>10</left>
            <top>10</top>
            <width>1260</width>
            <height>700</height>
            <textcolor>FFFFFFFF</textcolor>
            <font>font13</font>
            <pagecontrol>2</pagecontrol>
            <label></label>
        </control>
        <control type="scrollbar" id="2">
            <right>0</right>
            <top>0</top>
            <width>20</width>
            <height>720</height>
            <orientation>vertical</orientation>
            <textureslidernib>log_nib.png</textureslidernib>
            <textureslidernibfocus>log_nib.png</textureslidernibfocus>
            <texturesliderbackground></texturesliderbackground>
            <texturesliderbar></texturesliderbar>
            <texturesliderbarfocus></texturesliderbarfocus>
        </control>
    </controls>
</window>
