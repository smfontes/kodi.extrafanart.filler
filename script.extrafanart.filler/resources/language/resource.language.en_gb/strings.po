msgctxt "#30000"
msgid "Settings"
msgstr "Settings"

msgctxt "#30100"
msgid "Specify options for ExtraFanart Filler"
msgstr "Specify options for ExtraFanart Filler"

msgctxt "#30001"
msgid "Maximum extrafanart images"
msgstr "Maximum extrafanart images"

msgctxt "#30101"
msgid "Number (N) of fanart slots to fill (fanart1, fanart2, ..., fanartN)"
