# Errors
#=======

msgctxt "#30901"
msgid "{0} Auth Error. Likely cause is invalid API key in settings."
msgstr "{0} Auth Error. Likely cause is invalid API key in settings."

msgctxt "#30902"
msgid "{0} Http Error {1}. {2}."
msgstr "{0} Http Error {1}. {2}."

msgctxt "#30903"
msgid "Network Error for {0}."
msgstr "Network Error for {0}."

msgctxt "#30904"
msgid "{0} not available and cache empty. {0} will not be used"
msgstr "{0} not available and cache empty. {0} will not be used"

msgctxt "#30905"
msgid "{0} not available. Only cache will be used"
msgstr "{0} not available. Only cache will be used"

msgctxt "#30906"
msgid "No providers available, ExtraFanart Filler stopped"
msgstr "No providers available, ExtraFanart Filler stopped"

msgctxt "#30907"
msgid "Movie sets will not be scanned"
msgstr "Movie sets will not be scanned"

msgctxt "#30908"
msgid "Movie sets require both providers, ExtraFanart Filler stopped"
msgstr "Movie sets require both providers, ExtraFanart Filler stopped"
