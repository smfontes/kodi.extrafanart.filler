msgctxt "#30002"
msgid "Scan Movies"
msgstr "Scan Movies"

msgctxt "#30102"
msgid "Enable to search for extrafanart for Movies"
msgstr "Enable to search for extrafanart for Movies"

msgctxt "#30003"
msgid "Scan TV Shows"
msgstr "Scan TV Shows"

msgctxt "#30103"
